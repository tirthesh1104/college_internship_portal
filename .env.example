# =============================================================================
# IPTS - Internship Performance Tracking System
# Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in your values for local development.
# On Vercel, set these in: Project Settings → Environment Variables

# --- AI Provider Keys (at least one required for AI features) ---

# Google Gemini API Key (Primary AI Provider)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Anthropic Claude API Key (Fallback AI Provider, optional)
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# --- App Configuration ---

# App URL (used for self-referential links, QR codes, and certificate verification URLs)
# For Vercel: set this to your deployment URL, e.g. https://ipts.vercel.app
APP_URL="http://localhost:3000"

# Node environment (Vercel sets this automatically to "production")
# NODE_ENV="production"
