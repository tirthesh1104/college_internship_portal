# =============================================================================
# IPTS - Internship Performance Tracking System
# Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in your values for local development.
# On Vercel, set these in: Project Settings → Environment Variables

# --- AI Provider Keys (at least one required for AI features) ---

# Google Gemini API Key (Primary AI Provider)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Anthropic Claude API Key (Fallback AI Provider, optional)
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# --- Security & Authentication PINs ---

# Admin Security PIN: Strict 1 to 4 numeric digits (e.g., "1234", "0123", "99")
# NOTE: A 1–4 digit numeric PIN has lower entropy (max 10,000 combinations).
# Strong server-side brute force rate limiting and security audit logs are enforced.
ADMIN_SECURITY_PIN="1234"

# Coordinator Security PIN (e.g., "77")
COORDINATOR_SECURITY_PIN="77"

# Token signing secret (HMAC SHA-256 for session JWTs — generate a random 32+ character string)
TOKEN_SIGNING_SECRET="generate_a_strong_random_secret_here"

# --- App Configuration ---

# App URL (used for self-referential links, QR codes, and certificate verification URLs)
# For Vercel: set this to your deployment URL, e.g. https://ipts.vercel.app
APP_URL="http://localhost:3000"

# --- Durable Database Storage (Recommended for Vercel Serverless) ---
# When deployed to Vercel, attach a Vercel KV store (or Upstash Redis) in Project Settings -> Storage.
# Vercel will automatically populate these variables for zero-setup durable persistence:
# KV_REST_API_URL="https://your-kv-instance.upstash.io"
# KV_REST_API_TOKEN="your_upstash_rest_token"

# Frontend API URL (for separate frontend deployments like Netlify)
# When deploying the static frontend to Netlify and backend to Render/Vercel/Railway:
# VITE_API_URL="https://your-backend-api.vercel.app/api"

# Node environment (Vercel/Netlify sets this automatically to "production")
# NODE_ENV="production"
