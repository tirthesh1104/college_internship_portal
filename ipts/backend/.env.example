# Database Configuration (MySQL)
DB_ENGINE=mysql
DB_NAME=mitcorer_internship_hub
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Security & Application Settings
SECRET_KEY=django-insecure-mitcorer-change-in-production-key-2026-xyz
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Storage
MEDIA_ROOT=media
PRIVATE_STORAGE_DIR=media/private_documents

# Role Verification Security PINs (Server-Side Only)
COORDINATOR_SECURITY_PIN=your_coordinator_security_pin
ADMIN_SECURITY_PIN=your_admin_security_pin

