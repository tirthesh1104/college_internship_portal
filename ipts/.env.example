# ====================================================================
# Internship Performance Tracking System (IPTS) - Environment Variables
# ====================================================================
# Instructions:
# 1. Create a project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy the Project URL and anon / public API key
# 4. Copy this file to .env and fill in the values below:
#    cp .env.example .env (or in frontend/.env)
# 
# SECURITY WARNING:
# NEVER expose the service_role secret key in frontend code or commit .env files!
# ====================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
VITE_APP_ENV=development
